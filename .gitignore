```gitignore
# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-ssr/
build/
out/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python cache and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Testing and coverage
coverage/
.nyc_output/

# IDE and editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Local databases
*.sqlite
*.sqlite3
*.db
