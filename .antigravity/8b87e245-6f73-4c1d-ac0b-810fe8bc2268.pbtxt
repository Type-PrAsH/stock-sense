      create_file {
        instruction: "import { MarketIndex, NewsArticle } from \'../src/types\';\n\nexport const getCuratedArticles = (referenceTime: number = Date.now()): NewsArticle[] => {\n  const hour = 3600 * 1000;\n  const day = 24 * hour;\n\n  return [\n    {\n      id: \'art-in-rel-1\',\n      title: \'Reliance Industries Advances Clean Energy Push with 20GW Solar Gigafactory Roadmap\',\n      summary: \'Reliance Industries accelerated its new energy investment roadmap with construction milestones reached at the Dhirubhai Ambani Green Energy Giga Complex in Jamnagar. Brokerage upgrades cite expanding integrated retail footprint and resilient Jio ARPU growth.\',\n      content: \'Reliance Industries (RIL) reiterated its commitment to commissioning the first phase of its solar photovoltaic and energy storage giga-factories. Analysts at Jefferies and Morgan Stanley reaffirmed their overweight stance, projecting double-digit earnings compounding across petrochemicals, retail expansion, and 5G subscriber monetisation.\',\n      source: { name: \'The Economic Times\', url: \'https://economictimes.indiatimes.com\' },\n      url: \'https://economictimes.indiatimes.com/markets/stocks/news/reliance-industries-clean-energy-jamnagar\',\n      imageUrl: \'https://images.unsplash.com/photo-1509391365360-2e959784a276?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 1.2 * hour).toISOString(),\n      category: \'Stocks & Companies\',\n      market: \'India\',\n      relatedTickers: [\n        { symbol: \'RELIANCE\', name: \'Reliance Industries Ltd\', exchange: \'NSE\', changePercent: 1.45 },\n      ],\n      sentiment: \'bullish\',\n      isFeatured: true,\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-gl-nvda-2\',\n      title: \'Nvidia Surges on Next-Generation AI Chip Architecture and Record Data Center Demand\',\n      summary: \'Hyperscalers ramp capital expenditure as Nvidia reports unprecedented enterprise bookings for Blackwell and accelerated computing systems. Wall Street raises consensus targets citing generational compute efficiency gains.\',\n      content: \'Semiconductor bellwether Nvidia touched fresh session highs following reports of accelerated production deliveries to major cloud platforms. Industry analysts highlighted gross margin resilience exceeding 73% despite supply-chain packaging bottlenecks.\',\n      source: { name: \'Bloomberg\', url: \'https://bloomberg.com\' },\n      url: \'https://bloomberg.com/news/articles/nvidia-blackwell-demand-cloud-capex\',\n      imageUrl: \'https://images.unsplash.com/photo-1591488320449-011701bb6704?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 2.5 * hour).toISOString(),\n      category: \'Technology\',\n      market: \'US\',\n      relatedTickers: [\n        { symbol: \'NVDA\', name: \'NVIDIA Corporation\', exchange: \'NASDAQ\', changePercent: 3.82 },\n        { symbol: \'TSM\', name: \'Taiwan Semiconductor Mfg\', exchange: \'NYSE\', changePercent: 2.15 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 5,\n    },\n    {\n      id: \'art-in-rbi-3\',\n      title: \'RBI Monetary Policy Committee Maintains Repo Rate at 6.50% Amid Resilient GDP Growth\',\n      summary: \'The Reserve Bank of India retained its benchmark repo rate while reiterating a vigil on food price inflation. Governor highlighted robust domestic economic momentum with FY26 GDP growth projected above 7.0%.\',\n      content: \'In its scheduled bi-monthly monetary policy review, the Reserve Bank of India maintained the policy repo rate under the liquidity adjustment facility (LAF) at 6.50%. The MPC retained its policy stance of withdrawal of accommodation to ensure inflation aligns sustainably with target.\',\n      source: { name: \'Moneycontrol\', url: \'https://moneycontrol.com\' },\n      url: \'https://moneycontrol.com/news/business/economy/rbi-monetary-policy-repo-rate-decision\',\n      imageUrl: \'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 4.1 * hour).toISOString(),\n      category: \'Economy\',\n      market: \'India\',\n      relatedTickers: [\n        { symbol: \'BANKNIFTY\', name: \'Nifty Bank Index\', exchange: \'NSE\', changePercent: 0.65 },\n        { symbol: \'SBIN\', name: \'State Bank of India\', exchange: \'NSE\', changePercent: 1.12 },\n      ],\n      sentiment: \'neutral\',\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-in-hdfc-4\',\n      title: \'HDFC Bank Posts 16% Deposit Growth in Q3, Loan-to-Deposit Ratio Moderates to 98%\',\n      summary: \'Private banking heavyweight HDFC Bank demonstrated improving balance sheet metrics post-merger, propelled by institutional deposits and retail liability mobilization across Tier-2 and Tier-3 branches.\',\n      content: \'HDFC Bank reported net profit growth supported by net interest margin stabilization at 3.4%. Management signaled disciplined loan book underwriting in unsecured segments while prioritizing high-quality corporate and mortgage originations.\',\n      source: { name: \'Livemint\', url: \'https://livemint.com\' },\n      url: \'https://livemint.com/market/hdfc-bank-q3-results-deposits-nim\',\n      imageUrl: \'https://images.unsplash.com/photo-1541354329998-f4d9a9f9297f?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 5.8 * hour).toISOString(),\n      category: \'Earnings\',\n      market: \'India\',\n      relatedTickers: [\n        { symbol: \'HDFCBANK\', name: \'HDFC Bank Ltd\', exchange: \'NSE\', changePercent: 1.94 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 3,\n    },\n    {\n      id: \'art-gl-fed-5\',\n      title: \'US Treasury Yields Ease as Core PCE Moderates to 2.6%, Boosting Equity Futures\',\n      summary: \'Treasury 10-year yields slipped 7 basis points to 4.18% after Commerce Department data revealed headline and core consumer spending pressures continued their downward trajectory toward the 2% inflation target.\',\n      content: \'Bond markets rallied following the release of personal consumption expenditures price index figures. Traders increased implied probabilities of a 25 basis point Federal Reserve rate reduction at upcoming meetings, sending S&P 500 futures higher.\',\n      source: { name: \'Reuters\', url: \'https://reuters.com\' },\n      url: \'https://reuters.com/markets/us/treasury-yields-core-pce-inflation\',\n      imageUrl: \'https://images.unsplash.com/photo-1590283603385-17ffb3a7f29f?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 7.5 * hour).toISOString(),\n      category: \'Economy\',\n      market: \'US\',\n      relatedTickers: [\n        { symbol: \'SPX\', name: \'S&P 500 Index\', exchange: \'CBOE\', changePercent: 0.74 },\n        { symbol: \'QQQ\', name: \'Invesco QQQ Trust\', exchange: \'NASDAQ\', changePercent: 1.08 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-in-tata-6\',\n      title: \'Tata Motors Demerger Receives NCLT Clearance; Commercial & PV Units to List Separately\',\n      summary: \'The National Company Law Tribunal approved Tata Motors scheme of arrangement to demerge its commercial vehicle and passenger vehicle businesses, unlocking pure-play value for electric vehicle and luxury JLR platforms.\',\n      content: \'Under the court-approved scheme, shareholders will receive one mirror share in each standalone entity. Management noted the bifurcation will optimize capital allocation and strengthen Jaguar Land Rover electrification investments.\',\n      source: { name: \'Business Standard\', url: \'https://business-standard.com\' },\n      url: \'https://business-standard.com/companies/news/tata-motors-demerger-nclt-clearance\',\n      imageUrl: \'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 9.0 * hour).toISOString(),\n      category: \'Stocks & Companies\',\n      market: \'India\',\n      relatedTickers: [\n        { symbol: \'TATAMOTORS\', name: \'Tata Motors Ltd\', exchange: \'NSE\', changePercent: 2.85 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-in-ipo-7\',\n      title: \'Swiggy and NTPC Green Energy Secondary Performance Sparks New Wave of Tech IPO Filings\',\n      summary: \'Strong institutional bids for recent mega-offerings have prompted seven consumer tech and infrastructure unicorns to file draft red herring prospectuses (DRHPs) with market regulator SEBI.\',\n      content: \'SEBI primary market desk reported filing activity from enterprise software and renewable energy firms looking to raise an aggregate \342\202\27132,000 crore in the upcoming fiscal quarter. Domestic mutual funds absorbed over 45% of anchor allocations.\',\n      source: { name: \'The Financial Express\', url: \'https://financialexpress.com\' },\n      url: \'https://financialexpress.com/market/ipo-news/tech-ipo-filings-sebi-drhp\',\n      imageUrl: \'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 11.5 * hour).toISOString(),\n      category: \'IPOs\',\n      market: \'India\',\n      relatedTickers: [\n        { symbol: \'SWIGGY\', name: \'Swiggy Ltd\', exchange: \'NSE\', changePercent: -0.45 },\n        { symbol: \'ZOMATO\', name: \'Zomato Ltd\', exchange: \'NSE\', changePercent: 3.10 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 3,\n    },\n    {\n      id: \'art-gl-oil-8\',\n      title: \'Brent Crude Stabilizes at $76/bbl as Red Sea Maritime Risks Counter Global Surplus Forecasts\',\n      summary: \'Oil prices oscillated in narrow bands as supply disruptions and transit rerouting in key shipping corridors balanced EIA forecasts of non-OPEC output growth from the Americas.\',\n      content: \'Brent crude benchmarks hovered near $76.20 per barrel. Energy traders weighed voluntary OPEC+ quota compliance against resilient US shale production averaging 13.4 million barrels per day.\',\n      source: { name: \'CNBC\', url: \'https://cnbc.com\' },\n      url: \'https://cnbc.com/2026/energy/brent-crude-oil-red-sea-freight\',\n      imageUrl: \'https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 14.0 * hour).toISOString(),\n      category: \'Commodities\',\n      market: \'Global\',\n      relatedTickers: [\n        { symbol: \'BRENT\', name: \'Brent Crude Oil Benchmark\', exchange: \'ICE\', changePercent: -0.62 },\n        { symbol: \'ONGC\', name: \'Oil & Natural Gas Corp\', exchange: \'NSE\', changePercent: -0.35 },\n      ],\n      sentiment: \'neutral\',\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-gl-aapl-9\',\n      title: \'Apple Expands On-Device Intelligence Suite and Services Ecosystem in European Markets\',\n      summary: \'Cupertino-based Apple announced expanded localization of Apple Intelligence tools across five European languages, paired with record recurring subscriptions in iCloud and Apple Music.\',\n      content: \'Apple shares traded up 1.3% as Morgan Stanley reiterated top-pick status. Services division gross margins expanded to 74.8%, providing resilient recurring cash flow cushions during consumer hardware refresh cycles.\',\n      source: { name: \'Financial Times\', url: \'https://ft.com\' },\n      url: \'https://ft.com/content/apple-services-growth-ai-localization\',\n      imageUrl: \'https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 18.2 * hour).toISOString(),\n      category: \'Technology\',\n      market: \'US\',\n      relatedTickers: [\n        { symbol: \'AAPL\', name: \'Apple Inc\', exchange: \'NASDAQ\', changePercent: 1.34 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 3,\n    },\n    {\n      id: \'art-in-tcs-10\',\n      title: \'TCS Signs Multi-Year $1.2B Digital Transformation Pact with European Financial Giant\',\n      summary: \'Tata Consultancy Services secured a landmark banking modernization deal to transition legacy core platforms to microservices cloud infrastructure, reinforcing Indian IT deal pipeline strength.\',\n      content: \'TCS management commented that while discretionary consulting remains measured, large-scale vendor consolidation and cost-takeout contracts are generating strong conversion rates across BFSI and life sciences verticals.\',\n      source: { name: \'The Economic Times\', url: \'https://economictimes.indiatimes.com\' },\n      url: \'https://economictimes.indiatimes.com/tech/ites/tcs-signs-1-2-billion-dollar-deal\',\n      imageUrl: \'https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 22.0 * hour).toISOString(),\n      category: \'Indian Markets\',\n      market: \'India\',\n      relatedTickers: [\n        { symbol: \'TCS\', name: \'Tata Consultancy Services Ltd\', exchange: \'NSE\', changePercent: 2.15 },\n        { symbol: \'INFY\', name: \'Infosys Ltd\', exchange: \'NSE\', changePercent: 1.70 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-gl-gold-11\',\n      title: \'Gold Trades Near Historical Peaks on Central Bank Reserve Diversification and Geopolitical Hedging\',\n      summary: \'Spot gold held firm above $2,730/oz as sovereign central banks in emerging markets continued monthly net purchases, reinforcing the yellow metal as a hedge against sovereign debt issuance.\',\n      content: \'World Gold Council data indicated non-dollar reserve accumulation expanded for the tenth consecutive quarter. Gold ETF holdings recorded positive net inflows across North American and European funds.\',\n      source: { name: \'Reuters\', url: \'https://reuters.com\' },\n      url: \'https://reuters.com/markets/commodities/gold-prices-central-banks-hedging\',\n      imageUrl: \'https://images.unsplash.com/photo-1610375461246-83df859d849d?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 28.0 * hour).toISOString(), // ~1.1 days ago\n      category: \'Commodities\',\n      market: \'Global\',\n      relatedTickers: [\n        { symbol: \'XAUUSD\', name: \'Gold Spot USD\', exchange: \'FOREX\', changePercent: 0.88 },\n        { symbol: \'TITAN\', name: \'Titan Company Ltd\', exchange: \'NSE\', changePercent: -0.42 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 3,\n    },\n    {\n      id: \'art-in-zomato-12\',\n      title: \'Zomato Blinkit Dark-Store Count Crosses 1,000 Mark; Quick Commerce GMV Doubles Year-on-Year\',\n      summary: \'Zomato expanded its quick-commerce footprint ahead of guidance, driving rapid operating leverage and reducing store break-even horizons to under four months in high-density urban clusters.\',\n      content: \'Brokerages raised their target prices on Zomato following the operational release. Non-grocery categories including electronics, toys, and apparel grew to represent 22% of total order value.\',\n      source: { name: \'Mint\', url: \'https://livemint.com\' },\n      url: \'https://livemint.com/companies/news/zomato-blinkit-dark-stores-quick-commerce\',\n      imageUrl: \'https://images.unsplash.com/photo-1526367790999-0150786686a2?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 34.0 * hour).toISOString(),\n      category: \'Stocks & Companies\',\n      market: \'India\',\n      relatedTickers: [\n        { symbol: \'ZOMATO\', name: \'Zomato Ltd\', exchange: \'NSE\', changePercent: 4.25 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-gl-msft-13\',\n      title: \'Microsoft Azure Cloud Revenue Grows 29%, Powered by Enterprise Copilot Deployments\',\n      summary: \'Redmond tech titan reported accelerated corporate adoption of Azure OpenAI infrastructure with over 70% of Fortune 500 firms deploying generative enterprise agents.\',\n      content: \'Commercial cloud gross margins remained healthy at 71%. Microsoft reiterated plans to invest over $50 billion in AI datacenters and subsea fiber interconnects over the current calendar year.\',\n      source: { name: \'The Wall Street Journal\', url: \'https://wsj.com\' },\n      url: \'https://wsj.com/tech/microsoft-azure-earnings-cloud-growth\',\n      imageUrl: \'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 40.0 * hour).toISOString(),\n      category: \'Technology\',\n      market: \'US\',\n      relatedTickers: [\n        { symbol: \'MSFT\', name: \'Microsoft Corporation\', exchange: \'NASDAQ\', changePercent: 1.78 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 5,\n    },\n    {\n      id: \'art-gl-fed-14\',\n      title: \'European Central Bank Cuts Deposit Rate to 3.00% Following Slower Eurozone Manufacturing Activity\',\n      summary: \'The ECB reduced borrowing costs by 25 basis points as policymakers acknowledged continuing headwinds in German industrial output and softening wage settlements.\',\n      content: \'President Christine Lagarde emphasized data dependency, noting inflation across services remained sticky while headline consumer prices had fallen within target boundaries.\',\n      source: { name: \'Financial Times\', url: \'https://ft.com\' },\n      url: \'https://ft.com/content/ecb-interest-rate-cut-lagarde-speech\',\n      imageUrl: \'https://images.unsplash.com/photo-1526304640581-d334cdbbf45e?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 46.0 * hour).toISOString(),\n      category: \'Global Markets\',\n      market: \'Global\',\n      relatedTickers: [\n        { symbol: \'DAX\', name: \'DAX Performance-Index\', exchange: \'XETRA\', changePercent: 0.52 },\n        { symbol: \'EURUSD\', name: \'Euro / US Dollar\', exchange: \'FOREX\', changePercent: -0.31 },\n      ],\n      sentiment: \'neutral\',\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-in-airtel-15\',\n      title: \'Bharti Airtel ARPU Surges to \342\202\271233 as 5G Monetization and Postpaid Additions Accelerate\',\n      summary: \'Telecom major Bharti Airtel delivered industry-leading Average Revenue Per User (ARPU) metrics, supported by tariff revisions and healthy data consumption growth across metropolitan circles.\',\n      content: \'Airtel Africa and enterprise connectivity solutions contributed meaningfully to consolidated EBITDA margins, which reached 52.8%. Capital expenditure guidance for the fiscal year was maintained.\',\n      source: { name: \'Moneycontrol\', url: \'https://moneycontrol.com\' },\n      url: \'https://moneycontrol.com/news/telecom/bharti-airtel-q3-arpu-growth\',\n      imageUrl: \'https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 52.0 * hour).toISOString(),\n      category: \'Earnings\',\n      market: \'India\',\n      relatedTickers: [\n        { symbol: \'BHARTIARTL\', name: \'Bharti Airtel Ltd\', exchange: \'NSE\', changePercent: 1.62 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 3,\n    },\n    {\n      id: \'art-gl-tsla-16\',\n      title: \'Tesla Energy Storage Deployments Hit 15 GWh in Record Quarter, Surpassing Vehicle Margin Contribution\',\n      summary: \'Elon Musk-led Tesla revealed that Megapack and Powerwall installations generated record quarterly cash flow, offsetting automotive price discounting and EV production line retooling.\',\n      content: \'Wall Street equity research firms highlighted that energy generation and storage gross margins climbed to 30.5%, positioning the battery division as a primary driver of long-term profit expansion.\',\n      source: { name: \'Bloomberg\', url: \'https://bloomberg.com\' },\n      url: \'https://bloomberg.com/news/tesla-megapack-energy-storage-profits\',\n      imageUrl: \'https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 60.0 * hour).toISOString(),\n      category: \'Technology\',\n      market: \'US\',\n      relatedTickers: [\n        { symbol: \'TSLA\', name: \'Tesla Inc\', exchange: \'NASDAQ\', changePercent: -1.20 },\n      ],\n      sentiment: \'neutral\',\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-in-fii-17\',\n      title: \'Foreign Institutional Investors (FIIs) Return to Indian Equities with \342\202\2718,400 Cr Net Inflow\',\n      summary: \'Global funds resumed aggressive net purchases across banking and auto counters following a three-month consolidation period, propelled by stable bond spreads and steady earnings delivery.\',\n      content: \'Data from National Securities Depository Limited (NSDL) revealed domestic institutional investors (DIIs) also matched the trend with systematic SIP inflows reaching an all-time monthly high of \342\202\27125,300 crore.\',\n      source: { name: \'The Economic Times\', url: \'https://economictimes.indiatimes.com\' },\n      url: \'https://economictimes.indiatimes.com/markets/stocks/news/fii-inflows-indian-equities-nsdl-data\',\n      imageUrl: \'https://images.unsplash.com/photo-1642543492481-44e81e3914a7?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 72.0 * hour).toISOString(),\n      category: \'Indian Markets\',\n      market: \'India\',\n      relatedTickers: [\n        { symbol: \'NIFTY50\', name: \'Nifty 50 Index\', exchange: \'NSE\', changePercent: 1.15 },\n        { symbol: \'SENSEX\', name: \'S&P BSE Sensex\', exchange: \'BSE\', changePercent: 1.08 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 4,\n    },\n    {\n      id: \'art-gl-semis-18\',\n      title: \'Global Semiconductor Sales Expand 18% in FY25, Driven by Automotive and Server Silicon\',\n      summary: \'Semiconductor Industry Association reported global chip sales crossed $620 billion annualized run-rate, signaling an end to the inventory digestion phase in industrial and consumer electronics.\',\n      content: \'Leading foundries in Taiwan and South Korea reported wafer fab utilization surpassing 88%, driven by specialized silicon packaging for high-performance computing and on-device machine intelligence.\',\n      source: { name: \'Reuters\', url: \'https://reuters.com\' },\n      url: \'https://reuters.com/technology/semiconductor-industry-association-global-sales\',\n      imageUrl: \'https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=1200&q=80\',\n      publishedAt: new Date(referenceTime - 84.0 * hour).toISOString(),\n      category: \'Global Markets\',\n      market: \'Global\',\n      relatedTickers: [\n        { symbol: \'SOXX\', name: \'iShares Semiconductor ETF\', exchange: \'NASDAQ\', changePercent: 2.45 },\n        { symbol: \'NVDA\', name: \'NVIDIA Corporation\', exchange: \'NASDAQ\', changePercent: 3.82 },\n      ],\n      sentiment: \'bullish\',\n      readTimeMinutes: 5,\n    },\n  ];\n};\n\nexport const getCuratedMarketIndices = (): MarketIndex[] => {\n  const nowStr = new Date().toISOString();\n  return [\n    {\n      symbol: \'^NSEI\',\n      name: \'NIFTY 50\',\n      value: 24367.85,\n      change: 184.40,\n      changePercent: 0.76,\n      isPositive: true,\n      region: \'India\',\n      isDemo: true,\n      lastUpdated: nowStr,\n      currency: \'INR\',\n    },\n    {\n      symbol: \'^BSESN\',\n      name: \'SENSEX\',\n      value: 80112.50,\n      change: 542.25,\n      changePercent: 0.68,\n      isPositive: true,\n      region: \'India\',\n      isDemo: true,\n      lastUpdated: nowStr,\n      currency: \'INR\',\n    },\n    {\n      symbol: \'^NSEBANK\',\n      name: \'BANK NIFTY\',\n      value: 52140.20,\n      change: 368.10,\n      changePercent: 0.71,\n      isPositive: true,\n      region: \'India\',\n      isDemo: true,\n      lastUpdated: nowStr,\n      currency: \'INR\',\n    },\n    {\n      symbol: \'^GSPC\',\n      name: \'S&P 500\',\n      value: 5864.67,\n      change: -18.25,\n      changePercent: -0.31,\n      isPositive: false,\n      region: \'US\',\n      isDemo: true,\n      lastUpdated: nowStr,\n      currency: \'USD\',\n    },\n    {\n      symbol: \'^IXIC\',\n      name: \'NASDAQ Composite\',\n      value: 18518.61,\n      change: 85.40,\n      changePercent: 0.46,\n      isPositive: true,\n      region: \'US\',\n      isDemo: true,\n      lastUpdated: nowStr,\n      currency: \'USD\',\n    },\n    {\n      symbol: \'^DJI\',\n      name: \'Dow Jones\',\n      value: 42114.40,\n      change: -140.80,\n      changePercent: -0.33,\n      isPositive: false,\n      region: \'US\',\n      isDemo: true,\n      lastUpdated: nowStr,\n      currency: \'USD\',\n    },\n  ];\n};\n"
        path {
          absolute_uri: "file:///server/sampleData.ts"
        }
        overwrite: true
      }
    }
