      arguments_json: "{\"Append\":false, \"CodeContent\":\"import React, { useEffect } from \'react\';\\nimport { X, ExternalLink, Calendar, Building, Globe, Shield, TrendingUp, TrendingDown, Clock, Share2, Check } from \'lucide-react\';\\nimport { NewsArticle } from \'../types\';\\nimport { formatRelativeTime } from \'../utils/newsFilters\';\\n\\ninterface ArticleDetailModalProps {\\n  article: NewsArticle | null;\\n  onClose: () => void;\\n  onFilterByTicker: (ticker: string) => void;\\n}\\n\\nexport const ArticleDetailModal: React.FC<ArticleDetailModalProps> = ({\\n  article,\\n  onClose,\\n  onFilterByTicker,\\n}) => {\\n  const [copied, setCopied] = React.useState(false);\\n\\n  useEffect(() => {\\n    const handleKeyDown = (e: KeyboardEvent) => {\\n      if (e.key === \'Escape\') onClose();\\n    };\\n    if (article) {\\n      document.body.style.overflow = \'hidden\';\\n      window.addEventListener(\'keydown\', handleKeyDown);\\n    }\\n    return () => {\\n      document.body.style.overflow = \'unset\';\\n      window.removeEventListener(\'keydown\', handleKeyDown);\\n    };\\n  }, [article, onClose]);\\n\\n  if (!article) return null;\\n\\n  const handleCopyLink = () => {\\n    navigator.clipboard.writeText(article.url);\\n    setCopied(true);\\n    setTimeout(() => setCopied(false), 2000);\\n  };\\n\\n  const formattedExactDate = new Intl.DateTimeFormat(\'en-US\', {\\n    dateStyle: \'full\',\\n    timeStyle: \'medium\',\\n  }).format(new Date(article.publishedAt));\\n\\n  return (\\n    <div\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"article-detail-title\\\"\\n      className=\\\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/80 backdrop-blur-xs animate-in fade-in duration-200\\\"\\n    >\\n      <div\\n        className=\\\"w-full max-w-3xl max-h-[90vh] bg-[#121821] border border-[#1e293b] rounded-2xl shadow-2xl flex flex-col overflow-hidden text-slate-100\\\"\\n        onClick={(e) => e.stopPropagation()}\\n      >\\n        {/* Top Header Bar */}\\n        <div className=\\\"flex items-center justify-between px-6 py-4 border-b border-[#1e293b] bg-[#0e141c]\\\">\\n          <div className=\\\"flex items-center gap-2 text-xs\\\">\\n            <span className=\\\"font-semibold text-blue-400\\\">{article.source.name}</span>\\n            <span className=\\\"text-slate-600\\\">\342\200\242</span>\\n            <span className=\\\"px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-medium\\\">\\n              {article.category}\\n            </span>\\n            <span className=\\\"text-slate-400 font-mono text-[11px] uppercase\\\">\\n              {article.market}\\n            </span>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              onClick={handleCopyLink}\\n              title=\\\"Copy link to clipboard\\\"\\n              className=\\\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\\\"\\n              aria-label=\\\"Share story\\\"\\n            >\\n              {copied ? <Check className=\\\"w-4 h-4 text-emerald-400\\\" /> : <Share2 className=\\\"w-4 h-4\\\" />}\\n            </button>\\n            <button\\n              onClick={onClose}\\n              className=\\\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\\\"\\n              aria-label=\\\"Close article modal\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Scrollable Content */}\\n        <div className=\\\"flex-1 overflow-y-auto p-6 sm:p-8 space-y-6\\\">\\n          {/* Article Headline */}\\n          <h1 id=\\\"article-detail-title\\\" className=\\\"text-xl sm:text-2xl lg:text-3xl font-bold text-white leading-tight\\\">\\n            {article.title}\\n          </h1>\\n\\n          {/* Publishing Metadata */}\\n          <div className=\\\"flex flex-wrap items-center gap-4 text-xs text-slate-400 pb-4 border-b border-[#1e293b]\\\">\\n            <div className=\\\"flex items-center gap-1.5 font-mono\\\">\\n              <Calendar className=\\\"w-3.5 h-3.5 text-blue-400\\\" />\\n              <span>{formattedExactDate}</span>\\n            </div>\\n            <div className=\\\"flex items-center gap-1.5 font-mono\\\">\\n              <Clock className=\\\"w-3.5 h-3.5 text-slate-500\\\" />\\n              <span>{formatRelativeTime(article.publishedAt)}</span>\\n            </div>\\n            {article.readTimeMinutes && (\\n              <span className=\\\"text-slate-500\\\">\342\200\242 {article.readTimeMinutes} min read</span>\\n            )}\\n          </div>\\n\\n          {/* Article Image if available */}\\n          {article.imageUrl && (\\n            <div className=\\\"rounded-xl overflow-hidden bg-slate-900 border border-[#1e293b] max-h-80\\\">\\n              <img\\n                src={article.imageUrl}\\n                alt={article.title}\\n                className=\\\"w-full h-full object-cover\\\"\\n                loading=\\\"eager\\\"\\n              />\\n            </div>\\n          )}\\n\\n          {/* Related Company Tickers */}\\n          {article.relatedTickers.length > 0 && (\\n            <div className=\\\"p-4 rounded-xl bg-[#0b0f14] border border-[#1e293b] space-y-2\\\">\\n              <span className=\\\"text-xs font-semibold text-slate-400 uppercase tracking-wider block\\\">\\n                Related Equities & Tickers\\n              </span>\\n              <div className=\\\"flex flex-wrap gap-2\\\">\\n                {article.relatedTickers.map((t) => (\\n                  <button\\n                    key={t.symbol}\\n                    onClick={() => {\\n                      onFilterByTicker(t.symbol);\\n                      onClose();\\n                    }}\\n                    className=\\\"flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[#121821] hover:bg-[#1a2330] border border-[#1e293b] hover:border-blue-500/40 text-xs transition-colors group cursor-pointer\\\"\\n                  >\\n                    <span className=\\\"font-mono font-bold text-blue-400\\\">${t.symbol}</span>\\n                    <span className=\\\"text-slate-300 font-medium\\\">{t.name}</span>\\n                    {t.changePercent !== undefined && (\\n                      <span\\n                        className={`font-mono text-[11px] ${\\n                          t.changePercent >= 0 ? \'text-emerald-400\' : \'text-rose-400\'\\n                        }`}\\n                      >\\n                        {t.changePercent >= 0 ? \'+\' : \'\'}\\n                        {t.changePercent}%\\n                      </span>\\n                    )}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* Summary and Content Excerpt */}\\n          <div className=\\\"space-y-4 text-slate-300 leading-relaxed text-sm sm:text-base\\\">\\n            <p className=\\\"font-medium text-slate-200 bg-blue-950/20 p-4 rounded-xl border border-blue-900/30\\\">\\n              {article.summary}\\n            </p>\\n            {article.content && article.content !== article.summary && (\\n              <p className=\\\"text-slate-300\\\">{article.content}</p>\\n            )}\\n          </div>\\n\\n          {/* Publisher Notice & Direct Source Link */}\\n          <div className=\\\"p-4 rounded-xl bg-[#0e141c] border border-[#1e293b] flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n            <div className=\\\"space-y-1\\\">\\n              <span className=\\\"text-xs font-semibold text-slate-300\\\">\\n                Original Reporting by {article.source.name}\\n              </span>\\n              <p className=\\\"text-[11px] text-slate-400 max-w-md\\\">\\n                StockSense terminal respects intellectual property and provides licensed summaries &amp; metadata. Read full editorial coverage directly at the publisher.\\n              </p>\\n            </div>\\n\\n            <a\\n              href={article.url}\\n              target=\\\"_blank\\\"\\n              rel=\\\"noopener noreferrer\\\"\\n              className=\\\"inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs shadow-md transition-all shrink-0 cursor-pointer\\\"\\n            >\\n              <span>Read Original Article</span>\\n              <ExternalLink className=\\\"w-3.5 h-3.5\\\" />\\n            </a>\\n          </div>\\n        </div>\\n\\n        {/* Modal Footer */}\\n        <div className=\\\"px-6 py-3 border-t border-[#1e293b] bg-[#0e141c] flex items-center justify-between text-xs text-slate-400\\\">\\n          <span className=\\\"font-mono\\\">StockSense Research Desk</span>\\n          <button\\n            onClick={onClose}\\n            className=\\\"px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors\\\"\\n          >\\n            Close\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Article details modal with full metadata, tickers, and publisher link\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ArticleDetailModal.tsx\", \"toolAction\":\"Writing ArticleDetailModal component\", \"toolSummary\":\"Create ArticleDetailModal component\"}"
      thinking_signature: "\022\363\006\n\360\006\001i\024}\023\332A>\206>\264s\266Oz\375\321K1\226ma9z\2760\335Y\027\032\311\\\254\226\270\032m\312\320&T\366\274\237BP\300\202/\'\364\034C7\002\"\222 \005b1FQ\\\201H \021\240\372\016\020)\342\n%\250U\316K\005\375\346gl\252\332\000\235oc\243E\321\336\a\027\245X\224\036\225\321\363\034\224\373(\212\304\235\\\362dC\352\305\207\003Jj\021\003\362\3012\252\225\020EM{\252\207\316\371\325\310\237<g\230\020A\275\002\377\000\327\274\t\241\377\307G\332\016\305\005\267tE\317\030={\274[\226cc\243\263\271`\240\216\310\357\213c\331S,\245\2646\342\355(\353\316\303]/f\313\261\203\306@@\256\201\200wR\236\232\'\021}\277\340>\343\3260\261\247\374\254\231\034]\333\255\274Y\027\024\303\2073\231\334\373\210I^~\2748\331-\002W4\253\3038!\332j\223|\370}\337\023\216+af$\267\342RPZ\301z\316\273\357\304\277E\374\006\202\351)\347)\207m5\247\320Ww\333\247\370G\214\312\242=\357\026\377\273\213*\345\035K\340\277\255v\274\200\350\316|\303A\332;!eu\217\200\356:\233_K;\365\202\250\210\246\265b:\322qk\034I\311\342\271*\030n\372\233\214;g8A\303c\'\203\212\025\273\230:s\\\001^n\260\303\235e\244\017/M5\263\223e\"<9\001\333Z9\231851\210\250\345\345\371F\341\250\310\f\332\303\241\372~\352\002\306\214c\320G\023\346\274\247R\005\316.|\304\312\333,\341\2367\260Q+\t\270\347\026\237\377c3\204\245V\274\363Z+\213\316\034\032p\020\217\034\t\336\214&\201\3102\200\243\342\206\200\263A\336:h\a\322\246\a\364N]\320\n\3304@V\267\vQ\031\333x\216\211\211\344\037\242\006<\022\223\270\222\b\225\231Y0W\177\301\313\021\206\306\203h\230a\266\034\251$\221\257\253\307\372\251\006<b\\Ma\271l\351\214B\250\310h\256\003l\345\361\370\003\341\336\307\005\205|s\274\351VD\032O\224v\375\330Z\0323+\325n]\226\364j@\321\034(.\377k\215\270:\222 \005\265\225\207\320\362:=\365\0341\b\240\243\003\000\312J\220\360\351\361]^F\345\005!\254\035W/@a8\343\034p\243\v\024S\260\276\242*\227\345\274\034<\325\210& {\345\226\300:M\342\356\337\3344\025E\356\264Q\335!E\2744\016\347sp\255$M|\b\377\343\245`8\333