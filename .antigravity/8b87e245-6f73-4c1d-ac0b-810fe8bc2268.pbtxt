  code_action {
    action_spec {
      create_file {
        instruction: "import { NewsApiResponse, NewsArticle, MarketIndex } from \'../src/types\';\nimport { getCuratedArticles, getCuratedMarketIndices } from \'./sampleData\';\n\ninterface CacheEntry {\n  data: NewsArticle[];\n  timestamp: number;\n  sourceType: \'live_api\' | \'rss_live\' | \'curated_demo\';\n  sourceName?: string;\n  isDemoData: boolean;\n}\n\nlet cachedNews: CacheEntry | null = null;\nconst CACHE_TTL_MS = 2 * 60 * 1000; // 2 minutes\n\n/**\n * Fetch news from external APIs if keys are available, else fallback safely.\n */\nexport async function fetchNewsArticles(forceRefresh = false): Promise<NewsApiResponse> {\n  const now = Date.now();\n\n  if (!forceRefresh && cachedNews && now - cachedNews.timestamp < CACHE_TTL_MS) {\n    return {\n      articles: cachedNews.data,\n      isDemoData: cachedNews.isDemoData,\n      sourceType: cachedNews.sourceType,\n      sourceName: cachedNews.sourceName,\n      lastUpdated: new Date(cachedNews.timestamp).toISOString(),\n      totalCount: cachedNews.data.length,\n    };\n  }\n\n  const finnhubKey = process.env.FINNHUB_API_KEY?.trim();\n  const newsApiKey = process.env.NEWS_API_KEY?.trim();\n\n  // 1. Try Finnhub if key is present\n  if (finnhubKey) {\n    try {\n      const controller = new AbortController();\n      const timeout = setTimeout(() => controller.abort(), 6000);\n      const res = await fetch(`https://finnhub.io/api/v1/news?category=general&token=${finnhubKey}`, {\n        signal: controller.signal,\n      });\n      clearTimeout(timeout);\n\n      if (res.ok) {\n        const rawItems = await res.json();\n        if (Array.isArray(rawItems) && rawItems.length > 0) {\n          const articles: NewsArticle[] = rawItems.slice(0, 30).map((item: any, idx: number) => ({\n            id: `finnhub-${item.id || idx}`,\n            title: item.headline || \'Market Update\',\n            summary: item.summary || \'Summary unavailable.\',\n            content: item.summary,\n            source: { name: item.source || \'Finnhub\' },\n            url: item.url || \'https://finnhub.io\',\n            imageUrl: item.image || undefined,\n            publishedAt: item.datetime ? new Date(item.datetime * 1000).toISOString() : new Date().toISOString(),\n            category: mapFinnhubCategory(item.category),\n            market: \'Global\',\n            relatedTickers: item.related ? [{ symbol: item.related, name: item.related }] : [],\n            isFeatured: idx === 0,\n          }));\n\n          cachedNews = {\n            data: articles,\n            timestamp: now,\n            sourceType: \'live_api\',\n            sourceName: \'Finnhub Market News API\',\n            isDemoData: false,\n          };\n\n          return {\n            articles,\n            isDemoData: false,\n            sourceType: \'live_api\',\n            sourceName: \'Finnhub Market News API\',\n            lastUpdated: new Date(now).toISOString(),\n            totalCount: articles.length,\n          };\n        }\n      }\n    } catch (err: any) {\n      console.warn(\'Finnhub fetch failed, falling back to curated feed:\', err.message);\n    }\n  }\n\n  // 2. Try NewsAPI if key is present\n  if (newsApiKey) {\n    try {\n      const controller = new AbortController();\n      const timeout = setTimeout(() => controller.abort(), 6000);\n      const res = await fetch(\n        `https://newsapi.org/v2/top-headlines?category=business&language=en&pageSize=30&apiKey=${newsApiKey}`,\n        { signal: controller.signal }\n      );\n      clearTimeout(timeout);\n\n      if (res.ok) {\n        const data = await res.json();\n        if (data.status === \'ok\' && Array.isArray(data.articles) && data.articles.length > 0) {\n          const articles: NewsArticle[] = data.articles\n            .filter((a: any) => a.title && a.title !== \'[Removed]\')\n            .map((item: any, idx: number) => ({\n              id: `newsapi-${idx}`,\n              title: item.title,\n              summary: item.description || item.title,\n              content: item.content || item.description,\n              source: { name: item.source?.name || \'NewsAPI\' },\n              url: item.url,\n              imageUrl: item.urlToImage || undefined,\n              publishedAt: item.publishedAt || new Date().toISOString(),\n              category: \'Global Markets\',\n              market: \'Global\',\n              relatedTickers: [],\n              isFeatured: idx === 0,\n            }));\n\n          cachedNews = {\n            data: articles,\n            timestamp: now,\n            sourceType: \'live_api\',\n            sourceName: \'NewsAPI Business Desk\',\n            isDemoData: false,\n          };\n\n          return {\n            articles,\n            isDemoData: false,\n            sourceType: \'live_api\',\n            sourceName: \'NewsAPI Business Desk\',\n            lastUpdated: new Date(now).toISOString(),\n            totalCount: articles.length,\n          };\n        }\n      }\n    } catch (err: any) {\n      console.warn(\'NewsAPI fetch failed, falling back to curated feed:\', err.message);\n    }\n  }\n\n  // 3. Fallback: Curated high-fidelity financial research dataset\n  const fallbackArticles = getCuratedArticles(now);\n  cachedNews = {\n    data: fallbackArticles,\n    timestamp: now,\n    sourceType: \'curated_demo\',\n    sourceName: \'StockSense Curated Intelligence (Demo)\',\n    isDemoData: true,\n  };\n\n  return {\n    articles: fallbackArticles,\n    isDemoData: true,\n    sourceType: \'curated_demo\',\n    sourceName: \'StockSense Curated Intelligence (Demo Dataset)\',\n    lastUpdated: new Date(now).toISOString(),\n    totalCount: fallbackArticles.length,\n  };\n}\n\nexport function getMarketIndices(): MarketIndex[] {\n  return getCuratedMarketIndices();\n}\n\nfunction mapFinnhubCategory(cat?: string): any {\n  if (!cat) return \'Global Markets\';\n  const c = cat.toLowerCase();\n  if (c.includes(\'tech\')) return \'Technology\';\n  if (c.includes(\'earn\')) return \'Earnings\';\n  if (c.includes(\'merger\') || c.includes(\'company\')) return \'Stocks & Companies\';\n  if (c.includes(\'macro\') || c.includes(\'economy\')) return \'Economy\';\n  return \'Global Markets\';\n}\n"
        path {
          absolute_uri: "file:///server/newsService.ts"
        }
        overwrite: true
      }
    }
