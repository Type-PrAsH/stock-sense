      thinking_signature: "\022\241\017\n\236\017\001i\024}\023\210\334\305\020\207EE]?\235\005~\201\313\260\242<\211\244Q\275\223\341\212l\r\0325\373\323\313]\037\257J\027O\215\266H\220\311\313\t\366\363\215\030{@\366\351\376\023\035>p&\251Si=\236u\017\367(,\324\225\360P\3434\344\200\016\254\255\276o\325_\331<\237\303\347\352{\352\2738\311\021rZ\365\300\310P\367\360\247\320\270\253e\271S\322\251\363\30390\033\256\"h\226$\362\346W\306\337\255`\375\313C+\321\a\300\367\347?\341\301\276\354\315\003\203K\210\177:\332\360O%\002\037\203u\002\303\240~\324\217vCl\'\377Od\377\233\224\332\275\343\002J\231h\221\356S:%Pd\352\246\305\377\221u\364n\230\225\aL\032\343\353#\020\223|\311g\243\036\206&\241\252l\022\217\035\241B\347\357W|\033T\331\243L\020\311i5\220\241\005;\310\241\322\244\344\234\352\264v\v\325\356\212\036\242w\177\vQ\321\235\304\343\301\002\205$\264#\243\030\341\313a\302\244\001a\202\346\035+\200\352\t)}e\242\312%\005?=\204\3768\247>\257\342\213\314\237\330 5>\242?\"0A\022c}\366$\215x1\234%\320V\274\246\230k\201\t!\301>\313)\\\213y\330\205D\272\205\243\221l@\373\2215\322\a\0269\"\311\224FA@\256\312v\275\312\a^MQI\3509cN\023\352y\264\313\332\207\240\355\306le\260c\246\233tS=\\\350H\226D\216\356p*\232C\353!2U\310\020\2762#\210\r!-`\n\235\364>\226\243\311@\357\271@.\266\373as\203Le\310\305\303\276\356\222\245\212fTp\340K\217!\374A\222%\335qk\351\027b\271\263\nt\324%\037\262\356TK\233\321\330\372w\357\212\036#\355\346\001\347cD\312\202mvB\273N\\\241\022\300\273=\f\034\004~\\\034\000\206\272\275\343\316u\245\216}\344\247}\026\212/\273W\235\"\276\373VW\021\345\316\242\240s\322\231G\026\2160\367\033\317aov\347!NI\002\234\207\247\306\255m[\273\b\313\030\032[\223\243M\267B\0355\220\024\261\231\301\337\300s\031\241\214F/\330\213\t\352:\346\236z\017\263=\341\v\201u\3351F\232\326V.%\364\264.\026K\310\v.\236\245r\006)\017\000(\273\355$0\377JQ\344\377^e\311z\026\304\324y\322!?\3740\004k\375c)\327\272\377\266\224\r\f\343\bY\255\020\311\363\266\273\332\230l\354\362fjo\f\361\302c\2